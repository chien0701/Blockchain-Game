# ── 合約設定 ──────────────────────────────────────────────────────────────────
# 部署完成後填入（contracts/deployment.json 有記錄）

# GameCommitReveal：公平驗證合約（21點 / Mastermind）
VITE_CONTRACT_ADDRESS=

# FairBet：鏈上下注合約（骰子 / 硬幣 / 輪盤 / 拉霸）
# 不填則這些遊戲退回純驗證或模擬模式
VITE_FAIRBET_ADDRESS=

# 目標鏈 ID
# Ethereum Sepolia = 11155111
# Arbitrum Sepolia = 421614
# Hardhat Localhost = 31337
VITE_CHAIN_ID=11155111
