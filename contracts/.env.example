# ── 部署者私鑰（絕對不要 commit 真實私鑰！）──
# 從 MetaMask → Account Details → Export Private Key 取得
# 格式：不含 0x 前綴
DEPLOYER_PRIVATE_KEY=your_private_key_here

# ── Arbitrum Sepolia RPC（可用預設公共端點，或申請 Alchemy/Infura）──
# 公共端點：https://sepolia-rollup.arbitrum.io/rpc
# Alchemy：https://arb-sepolia.g.alchemy.com/v2/YOUR_API_KEY
ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ── Arbiscan API Key（選填，用於 verify contract）──
# 申請：https://arbiscan.io/myapikey
ARBISCAN_API_KEY=your_arbiscan_api_key_here

# ── 部署完成後填入（前端會用到）──
CONTRACT_ADDRESS=
